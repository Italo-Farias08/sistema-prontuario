# Copie este arquivo para ".env" em desenvolvimento local.
# No Railway, essas variáveis são configuradas em Project > Variables
# (a DATABASE_URL é criada automaticamente ao adicionar um serviço PostgreSQL).

PORT=3000
NODE_ENV=development

# String de conexão do PostgreSQL
DATABASE_URL=postgresql://usuario:senha@localhost:5432/prontuario

# Segredo usado para assinar os tokens JWT — troque por um valor aleatório forte
JWT_SECRET=troque-este-segredo-em-producao

# Origem permitida para CORS (use "*" em desenvolvimento)
CORS_ORIGIN=*
